{
  "name": "konsum-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host 0.0.0.0",
    "emulate": "firebase-tools-linux emulators:start --import=./emulatordata --export-on-exit",
    "emulatedev": "concurrently --names \"DEV,EMULATE\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev\" \"npm run emulate\"",
    "emulateexport": "firebase-tools-linux emulators:export ./emulatordata",
    "emulateimport": "firebase-tools-linux emulators:start --import=./emulatordata",
    "build": "vite build --mode production",
    "preview": "vite preview",
    "e2e": "vite build && vite preview --port 8080",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:coverage:report": "vitest run --coverage && open coverage/lcov-report/index.html",
    "test:emulate": "firebase-tools-linux emulators:start --import=./testseed",
    "test:createtestuser": "ts-node tests/scripts/createTestUser.ts",
    "test:clearauth": "ts-node tests/scripts/clearAuth.ts",
    "test:cleardb": "ts-node tests/scripts/clearDatabase.ts",
    "dev:emulator": "vite --mode local",
    "dev:mobile": "vite --mode mobile --host 0.0.0.0",
    "emulator": "firebase emulators:start --only auth,firestore,storage --host 0.0.0.0",
    "emulator:debug": "firebase emulators:start --only auth,firestore,storage --debug --host 0.0.0.0",
    "emulator:ui": "firebase emulators:start --only auth,firestore,storage --import=./firebase-export --export-on-exit=./firebase-export --host 0.0.0.0",
    "dev:full": "concurrently \"npm run emulator\" \"npm run dev:emulator\"",
    "dev:mobile-full": "concurrently \"npm run emulator\" \"npm run dev:mobile\"",
    "dev:debug": "concurrently \"npm run emulator:debug\" \"npm run dev:emulator\"",
    "type-check": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.7",
    "browser-image-compression": "^2.0.2",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^9.1.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^26.1.0",
    "knip": "^5.62.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.3"
  }
}
